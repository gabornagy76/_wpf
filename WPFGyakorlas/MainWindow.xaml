<Window x:Class="WPFGyakorlas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFGyakorlas"
        mc:Ignorable="d"
        Title="Üdvözlő alkalmazás"  
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen" SizeToContent="Height">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- 1. sor: -->
        <Label Grid.Row="0"
               Content="_Név:"               
               Target="{Binding ElementName=nevTextBox}"
               FontSize="18"
               Margin="0,0,0,10"/>

        <!-- 2. sor Név bekérése -->
        <TextBox Grid.Row="1"
                 x:Name="nevTextBox"
                 Height="35"
                 FontSize="16"
                 Padding="5"
                 Margin="0,0,0,15"/>


        <!-- 3. sor Életkor felirat -->
        <Label Grid.Row="2"
               Content="Add meg az _életkorodat:"
               Target="{Binding ElementName=eletkorTextBox}"
               FontSize="18"
               Margin="0,0,0,10"/>

        <!-- 4. sor Életkor bekérése-->
        <TextBox Grid.Row="3"
                 x:Name="eletkorTextBox"
                 Height="35"
                 FontSize="16"
                 Padding="5"
                 Margin="0,0,0,15"/>

        <!-- Gomb -->
        <Button Grid.Row="12"
                x:Name="udvozlesButton"
                Content="Üdvözlés"
                Width="130"
                Height="40"
                FontSize="16"
                HorizontalAlignment="Left"
                Click="udvozlesButton_Click"/>

        <!-- Az eredmény az utolsó sorba. -->
        <TextBlock Grid.Row="13"
                   x:Name="eredmenyTextBlock"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,25,0,0"
                   TextWrapping="Wrap"/>

        <CheckBox Grid.Row="4"
                  x:Name="wpfCheckBox"
                  Content="Szeretem a WPF-et"
                  FontSize="16"
                  Margin="0,0,0,15" IsChecked="False"/>


        <CheckBox Grid.Row="5"
                  x:Name="vremekCheckBox"
                  Content="Készül a vizsgaremek!"
                  FontSize="16"
                  Margin="0,0,0,15" IsChecked="False"/>

        <Label Grid.Row="6"
               Content="Nem:"
               FontSize="18"
               Padding="0"
               Margin="0,0,0,8"/>

        <StackPanel Grid.Row="7"
                    Margin="20,0,0,15">

            <RadioButton x:Name="ferfiRadioButton"
                         Content="Férfi"
                         GroupName="Nem"
                         IsChecked="True"
                         Margin="0,0,0,5"/>

            <RadioButton x:Name="noRadioButton"
                         Content="Nő"
                         GroupName="Nem"/>


        </StackPanel>

        <Label Grid.Row="8"
               Content="_Osztály:"
               Target="{Binding ElementName=osztalyComboBox}"
               FontSize="18"
               Padding="0"
               Margin="0,0,0,8"/>

        <ComboBox Grid.Row="9"
                  x:Name="osztalyComboBox"
                  Height="35"
                  FontSize="16"
                  Padding="5"
                  SelectedIndex="0"
                  Margin="0,0,0,15">

            <ComboBoxItem Content="9.A"/>
            <ComboBoxItem Content="9.B"/>
            <ComboBoxItem Content="10.A"/>
            <ComboBoxItem Content="10.B"/>
            <ComboBoxItem Content="11.A"/>
            <ComboBoxItem Content="11.B"/>
            <ComboBoxItem Content="12.A"/>
            <ComboBoxItem Content="12.B"/>

        </ComboBox>


        <!-- Ez a Label a ListBoxhoz tartozik.
        A Target segítségével összekapcsoljuk a Labelt a tantargyListBox vezérlővel. -->
        <Label Grid.Row="10"
               Content="_Kedvenc tantárgy:"
               Target="{Binding ElementName=tantargyListBox}"
               FontSize="18"
               Padding="0"
               Margin="0,0,0,8"/>

        <!--
        A ListBox egyszerre több elemet jelenít meg.
        A SelectionMode="Single" azt jelenti, hogy egyszerre csak egy tantárgy választható ki.
        A SelectedIndex="0" miatt induláskor az első tantárgy lesz kijelölve.
        -->
        <ListBox Grid.Row="11"
                 x:Name="tantargyListBox"
                 Height="115"
                 FontSize="16"
                 SelectionMode="Single"
                 SelectedIndex="0"
                 Margin="0,0,0,15">

            <!-- A lista választható elemei. -->
            <ListBoxItem Content="Matematika"/>
            <ListBoxItem Content="Fizika"/>
            <ListBoxItem Content="Digitális kultúra"/>
            <ListBoxItem Content="Történelem"/>
            <ListBoxItem Content="Magyar nyelv és irodalom"/>

        </ListBox>

    </Grid>
</Window>